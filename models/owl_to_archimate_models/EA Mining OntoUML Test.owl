<owl:Class rdf:about="process-view#FrequentTemporalCorrelation">
  <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Relator"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#mediates"/>
      <owl:onClass rdf:resource="process-view#APIAntecedentActivity"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#mediates"/>
      <owl:onClass rdf:resource="process-view#APIConsequentActivity"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
  <gufo:isDerivedFrom rdf:resource="process-view#apiConsequentActivityHistoricallyDependsOnApiAntecedentActivity"/>
  <rdf:type rdf:resource="http://purl.org/nemo/gufo#Relator"/>
  <rdfs:label xml:lang="en">Frequent Temporal Correlation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nemo/gufo#ComparativeRelationshipType"/>

